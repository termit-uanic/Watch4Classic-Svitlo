<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- to open the Wear OS or Galaxy Wearable app from the settings -->
    <queries>
        <package android:name="com.google.android.wearable.app" />
        <package android:name="com.samsung.android.app.watchmanager" />
    </queries>

    <!-- Nothing here runs a foreground service (WorkManager only brings the permission and the service along):
         leave them out, Google Play asks to explain every foreground service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".PhoneApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Wattlo">

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QueuesActivity"
            android:exported="false" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <receiver
            android:name=".SmallWidget"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small" />
        </receiver>

        <receiver
            android:name=".MediumWidget"
            android:exported="true"
            android:label="@string/widget_medium_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medium" />
        </receiver>

        <receiver
            android:name=".LargeWidget"
            android:exported="true"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large" />
        </receiver>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="false" />
    </application>
</manifest>
